{
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "portal.northstaracademicprep.com" }],
      "dest": "/portal.html"
    },
    {
      "src": "^/onboarding/?$",
      "dest": "/onboarding.html"
    },
    {
      "src": "^/tutor-apply/?$",
      "dest": "/tutor-apply.html"
    },
    {
      "src": "^/tutor-status/?$",
      "dest": "/tutor-status.html"
    },
    {
      "src": "^/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/$1"
    }
  ],
  "crons": [
    { "path": "/api/cron-weekly-reports", "schedule": "0 2 * * 1" },
    { "path": "/api/cron-session-reminders", "schedule": "0 15 * * *" }
  ]
}
